#!/bin/sh
set -e

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
fi

if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database /usr/share/mime || true
fi

python3 - <<'PY' || true
import json
from pathlib import Path

app = "notepadpp-linux.desktop"
mime_types = {
    "text/plain",
    "text/csv",
    "text/markdown",
    "text/html",
    "text/css",
    "text/x-python",
    "text/x-csrc",
    "text/x-c++src",
    "text/x-chdr",
    "text/x-c++hdr",
    "text/x-java",
    "text/x-shellscript",
    "application/javascript",
    "text/javascript",
    "application/typescript",
    "text/typescript",
    "application/json",
    "application/xml",
    "text/xml",
    "application/x-yaml",
    "text/x-yaml",
    "text/x-sql",
    "text/x-go",
    "text/x-rustsrc",
    "application/x-notepadpp-project",
}

state_path = Path("/var/lib/notepadpp-linux/mimeapps-defaults.json")
path = Path("/usr/share/applications/mimeapps.list")
previous = {}
if state_path.exists():
    previous = json.loads(state_path.read_text(encoding="utf-8"))

if path.exists():
    out = []
    in_defaults = False
    restored = set()
    for line in path.read_text(encoding="utf-8").splitlines(keepends=True):
        stripped = line.strip()
        if stripped == "[Default Applications]":
            in_defaults = True
            out.append(line)
            continue
        if stripped.startswith("[") and stripped.endswith("]"):
            for key, value in previous.items():
                if key not in restored:
                    out.append(f"{key}={value}\n")
                    restored.add(key)
            in_defaults = False
            out.append(line)
            continue
        if in_defaults and "=" in line:
            key, value = line.split("=", 1)
            if key in mime_types and value.strip() == app:
                if key in previous:
                    out.append(f"{key}={previous[key]}\n")
                    restored.add(key)
                continue
        out.append(line)
    if in_defaults:
        for key, value in previous.items():
            if key not in restored:
                out.append(f"{key}={value}\n")
    path.write_text("".join(out), encoding="utf-8")
PY

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor || true
fi
