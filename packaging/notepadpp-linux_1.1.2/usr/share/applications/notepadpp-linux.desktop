[Desktop Entry]
Version=1.0
Type=Application
Name=Notepad light
Comment=Notepad++-style text editor
Exec=notepadpp-linux %F
Icon=notepadpp-linux
Terminal=false
Categories=Utility;TextEditor;Development;
